# Copy to .env and fill in — never commit the real .env file.

# Private key of a testnet-only wallet funded with Robinhood Chain testnet ETH.
# Get testnet ETH from the official faucet linked at docs.robinhood.com/chain.
# NEVER use a key that holds real / mainnet funds.
DEPLOYER_PRIVATE_KEY=0x...

# Optional — only needed if verifying contracts on the block explorer.
ROBINHOOD_EXPLORER_API_KEY=
